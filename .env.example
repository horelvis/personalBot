# The only required setting. Matches docker-compose.yml.
DATABASE_URL=postgres://personalbot:personalbot@localhost:5432/personalbot
PORT=3001

# Built-in assistant. Credentials: ANTHROPIC_API_KEY, or a profile from `ant auth login`.
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-opus-5-5
# Or a gateway that speaks the Anthropic Messages API, e.g. OpenRouter (leave ANTHROPIC_API_KEY empty):
# ANTHROPIC_BASE_URL=https://openrouter.ai/api
# ANTHROPIC_AUTH_TOKEN=
# ASSISTANT_MODEL=deepseek/deepseek-v4.1-flash

# Sign-in. Pick one.
# Development only: every request is one local person, no login. Refused unless NODE_ENV=development.
# SINGLE_USER=true
# NODE_ENV=development
#
# Any OpenID Connect provider (Google, Microsoft Entra, Keycloak, Authentik…).
# Register the redirect URI <PUBLIC_URL>/auth/callback at the provider.
# OIDC_ISSUER=https://accounts.google.com
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# PUBLIC_URL=http://localhost:3001
# Required with OIDC: the one person this instance serves. Anyone else gets 403; someone else runs their own instance.
# OWNER_EMAIL=ana@example.com
# Only emails the provider marks email_verified sign in. Set to true for providers that never send it (e.g. Microsoft Entra).
# OIDC_TRUST_UNVERIFIED_EMAIL=false
